# Hardware configuration for host 'laptop'
# Originally generated by 'nixos-generate-config', now managed via flake.
{
  config,
  lib,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot = {
    initrd = {
      availableKernelModules = ["nvme" "xhci_pci" "ahci" "usbhid"];
      # `boot.initrd.kernelModules` and `boot.extraModulePackages` are
      # concatenating lists in nixpkgs — assigning an empty list does not
      # clear them. They are therefore left out on purpose instead of being
      # written as `[]`, which would read like a reset that never happens.
    };
    kernelModules = ["kvm-amd"];
  };

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/f78f3d04-92d0-4761-bb2c-73eb26f454c8";
    fsType = "ext4";
    options = ["noatime" "nodiratime"];
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/1704-F1AD";
    fsType = "vfat";
    options = ["fmask=0077" "dmask=0077"];
  };

  swapDevices = [
    {device = "/dev/disk/by-uuid/daa3071f-2019-4bca-aa51-e30a28ff8275";}
  ];

  # The platform is NOT set here. `lib/mkHost.nix` owns
  # `nixpkgs.hostPlatform` and takes it from the `system` argument that
  # flake.nix passes per host. Setting it again with `mkDefault` would only
  # create a second, dead source of truth.

  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
